modules = ["web", "bash", "nodejs-22"]
[agent]
expertMode = true
# Auth and database are provided by Neon (Managed Better Auth + Postgres).
# Provision with: NEON_API_KEY=... bash scripts/neon-setup.sh
integrations = []

[nix]
channel = "stable-25_05"
packages = ["unzipNLS"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 1455
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[userenv]

[userenv.shared]
# Secrets must NOT live in this file (it is committed to git).
# Set SUPER_AGENT_HEARTBEAT_SECRET (and other secrets) in Replit:
#   Workspace -> Tools -> Secrets. The previously committed value has been
#   exposed and should be rotated.
SUPER_AGENT_HEARTBEAT_SECRET = "SET-VIA-REPLIT-SECRETS"

[userenv.development]

[userenv.production]

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "start"]
build = ["npm", "run", "build"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
